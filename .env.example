DATABASE_URL=postgresql://...-pooler...
DATABASE_URL_UNPOOLED=postgresql://...
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# MiniSend merchant / onramp API
MINISEND_API_KEY=ms_live_your_key_here

# MiniSend Wallet API (Dashboard → Wallets, wsk_live_...)
MINISEND_WALLET_API_KEY=wsk_live_your_key_here
MINISEND_WALLET_API_BASE=https://merchant.minisend.xyz
MINISEND_WEBHOOK_SECRET=your_minisend_webhook_secret


# Deployed TabSettlement contract on Arc Testnet
NEXT_PUBLIC_TAB_SETTLEMENT_CONTRACT=0x...

# Arc Mainnet settlement
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_MAINNET_CHAIN_ID=5042
ARC_MAINNET_USDC=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_TAB_SETTLEMENT_CONTRACT_MAINNET=0x339267157fb31b3c1f00d49d14e39b54ce51dc54

# Circle Arc Onramp. Production key from Circle Console.
ONRAMP_API_KEY=
# Hostname only when embedding is enabled, e.g. clearyourtab.xyz
ONRAMP_REFERRER_DOMAIN=clearyourtab.xyz
